{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "stm32",
      "displayName": "STM32F103C8T6 (Ninja + arm-none-eabi-gcc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "C:/Users/86139/stm32-tools/ninja/bin/ninja.exe"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "stm32" }
  ],
  "workflowPresets": [
    {
      "name": "build",
      "steps": [
        { "type": "configure", "name": "stm32" },
        { "type": "build", "name": "default" }
      ]
    }
  ]
}
