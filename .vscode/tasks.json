{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "detail": "全局编译：配置(CMake) + 编译(Ninja)，生成 build/oled1.elf/hex/bin",
            "type": "shell",
            "command": "C:\\Users\\86139\\stm32-tools\\cmake\\bin\\cmake.exe",
            "args": [
                "--workflow",
                "--preset",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Flash (ST-Link)",
            "detail": "先编译，再用 OpenOCD 经 ST-Link 烧录并复位运行（在线烧录，HLA 模式适配旧版 ST-Link 固件 V2J23）",
            "type": "shell",
            "command": "C:\\Users\\86139\\stm32-tools\\openocd\\bin\\openocd.exe",
            "args": [
                "-f",
                "interface/stlink-hla.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "program build/oled1.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "dependsOn": [
                "Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "Erase (ST-Link)",
            "detail": "整片擦除",
            "type": "shell",
            "command": "C:\\Users\\86139\\stm32-tools\\openocd\\bin\\openocd.exe",
            "args": [
                "-f",
                "interface/stlink-hla.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "init; reset halt; stm32f1x mass_erase 0; reset run; exit"
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "detail": "清理构建产物",
            "type": "shell",
            "command": "C:\\Users\\86139\\stm32-tools\\ninja\\bin\\ninja.exe",
            "args": [
                "-C",
                "${workspaceFolder}/build",
                "clean"
            ],
            "problemMatcher": []
        }
    ]
}
