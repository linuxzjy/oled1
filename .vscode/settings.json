{
    // 本机工具均安装在 C:\Users\86139\stm32-tools
    // 修改了工具位置时，同步改这里即可
    "cmake.cmakePath": "C:\\Users\\86139\\stm32-tools\\cmake\\bin\\cmake.exe",
    "cmake.preset": "stm32",
    "cmake.configureOnOpen": true,
    "cmake.environment": {
        "PATH": "C:\\Users\\86139\\stm32-tools\\gcc\\bin;C:\\Users\\86139\\stm32-tools\\ninja\\bin;${env:PATH}"
    },
    "terminal.integrated.env.windows": {
        "PATH": "C:\\Users\\86139\\stm32-tools\\gcc\\bin;C:\\Users\\86139\\stm32-tools\\openocd\\bin;C:\\Users\\86139\\stm32-tools\\cmake\\bin;C:\\Users\\86139\\stm32-tools\\ninja\\bin;${env:PATH}"
    },
    // IntelliSense 直接读取 CMake 的编译参数（compile_commands.json），
    // 头文件路径和宏定义跟着构建走，不会出现红色波浪线
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compilerPath": "C:\\Users\\86139\\stm32-tools\\gcc\\bin\\arm-none-eabi-gcc.exe",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.default.cStandard": "c11",
    "cortex-debug.openocdPath": "C:\\Users\\86139\\stm32-tools\\openocd\\bin\\openocd.exe",
    "files.associations": {
        "*.h": "c"
    },
    // tools/*.py（cam_serial.py 等）用的解释器：装了 numpy / pyserial / opencv 的那个。
    // 换了 Python 就改这里，否则 IDE 会报一堆"无法解析导入"。
    "python.defaultInterpreterPath": "C:\\Users\\86139\\.workbuddy\\binaries\\python\\versions\\3.14.3\\python.exe",
    // basedpyright 默认开到最严格的 all，会对没写类型注解的脚本刷出上百条噪音。
    // 这是烧录/调试用的小工具脚本，降到 standard 就够。
    "python.analysis.typeCheckingMode": "standard",
    "basedpyright.analysis.typeCheckingMode": "standard"
}
